# Application
APP_NAME=FocusFlow API
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL primary; Render postgres:// URLs are normalized automatically)
DATABASE_URL=postgresql+psycopg2://focusflow:focusflow@localhost:5432/focusflow

# JWT Security (replace with a strong random secret in production)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated frontend URLs; include your Vercel domain in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex to allow Vercel preview deployments, e.g.: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Frontend URL
FRONTEND_URL=http://localhost:3000
